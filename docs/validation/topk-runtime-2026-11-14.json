    },
    {
      "file": "packages/core/src/query.ts",
      "symbol": "tryColumnarTopKRows",
      "finding": "serializedBatchBytes(retained, sizing) runs after every candidate merge even when maxMemoryBytes is undefined. This fixture configures maxAllocatedMemoryBytes only; the serialized-size scan cannot reject it."
    }
