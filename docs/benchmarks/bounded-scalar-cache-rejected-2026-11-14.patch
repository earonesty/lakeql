diff --git a/packages/core/src/scalar-text-cache.ts b/packages/core/src/scalar-text-cache.ts
new file mode 100644
index 0000000..1c61aeb
--- /dev/null
+++ b/packages/core/src/scalar-text-cache.ts
@@ -0,0 +1,131 @@
+import { MATERIALIZATION_CHARGES as c } from "./allocation-charges.js";
+import { LakeqlError } from "./errors.js";
+import type { MemoryReservation } from "./memory-budget.js";
+import { MemoryScope, type OwnedMemory } from "./memory-scope.js";
+
+type Slot = { source: WeakRef<object>; index: number; owner: OwnedMemory<string> };
+
+/** Optional immutable scalar storage. Weak identity keys cannot pin input pages;
+ * independently owned hits survive cache eviction while a comparator uses them.
+ * This primitive does not choose an admission/reuse policy for the caller. */
+export class ScalarTextCache {
+  private slots: (Slot | undefined)[] | undefined;
+  private directory: MemoryReservation | undefined;
+  private detachReclaimer: (() => void) | undefined;
+  private closed = false;
+  private payloadBytes = 0;
+  private readonly close = () => this.dispose();
+
+  static directoryBytes(capacity: number): number {
+    return (
+      c.object + 6 * c.property + c.array + capacity * (c.arraySlot + 2 * c.object + 3 * c.property)
+    );
+  }
+
+  static create(scope: MemoryScope, maxBytes: number, capacity = 8): ScalarTextCache | undefined {
+    if (
+      !Number.isSafeInteger(maxBytes) ||
+      maxBytes < 0 ||
+      !Number.isSafeInteger(capacity) ||
+      capacity < 1 ||
+      capacity > 256 ||
+      (capacity & (capacity - 1)) !== 0
+    )
+      throw new LakeqlError("LAKEQL_VALIDATION_ERROR", "Invalid scalar cache extent");
+    const bytes = ScalarTextCache.directoryBytes(capacity);
+    // Stage extents are consumed irreversibly. Optional cache admission must not
+    // consume capacity that cannot be returned for subsequent mandatory work.
+    if (
+      scope.disposed ||
+      scope.hasAdmission ||
+      bytes > maxBytes ||
+      bytes > scope.availableAllocationBytes
+    )
+      return undefined;
+    const admission = scope.reserve(bytes, "optional scalar cache directory");
+    try {
+      const cache = new ScalarTextCache(scope, maxBytes, capacity, admission);
+      return cache;
+    } catch (error) {
+      admission.release();
+      throw error;
+    }
+  }
+
+  private constructor(
+    private readonly scope: MemoryScope,
+    private readonly maxBytes: number,
+    private readonly capacity: number,
+    admission: MemoryReservation,
+  ) {
+    this.directory = admission;
+    this.slots = new Array(capacity);
+    this.detachReclaimer = scope.budget.registerReclaimer(this.close, "workspace");
+    scope.signal.addEventListener("abort", this.close, { once: true });
+  }
+
+  get(source: object, index: number): OwnedMemory<string> | undefined {
+    if (this.closed) return undefined;
+    const slot = this.slots?.[this.position(index)];
+    if (slot?.source.deref() !== source || slot.index !== index) return undefined;
+    return slot.owner.retain();
+  }
+
+  put(source: object, index: number, text: string): boolean {
+    const slots = this.slots;
+    if (this.closed || slots === undefined) return false;
+    const position = this.position(index);
+    const previous = slots[position];
+    if (previous !== undefined) {
+      slots[position] = undefined;
+      this.payloadBytes -= previous.owner.bytes;
+      previous.owner.release();
+    }
+    const bytes = c.string + text.length * c.stringCodeUnit;
+    if (
+      bytes + this.payloadBytes + (this.directory?.bytes ?? 0) > this.maxBytes ||
+      bytes > this.scope.availableAllocationBytes
+    )
+      return false;
+    const admission = this.scope.reserve(bytes, "optional cached scalar text");
+    const ownerScope = new MemoryScope(this.scope.budget);
+    try {
+      const owner = ownerScope.allocateReserved(admission, () => text).retain();
+      try {
+        slots[position] = { source: new WeakRef(source), index, owner };
+      } catch (error) {
+        owner.release();
+        throw error;
+      }
+      this.payloadBytes += bytes;
+      return true;
+    } finally {
+      ownerScope.dispose();
+    }
+  }
+
+  dispose(): void {
+    if (this.closed) return;
+    this.closed = true;
+    this.scope.signal.removeEventListener("abort", this.close);
+    this.detachReclaimer?.();
+    this.detachReclaimer = undefined;
+    const slots = this.slots;
+    this.slots = undefined;
+    try {
+      for (const slot of slots ?? []) slot?.owner.release();
+    } finally {
+      this.payloadBytes = 0;
+      this.directory?.release();
+      this.directory = undefined;
+    }
+  }
+
+  private position(index: number): number {
+    if (!Number.isSafeInteger(index) || index < 0 || index > 0xffffffff)
+      throw new LakeqlError("LAKEQL_VALIDATION_ERROR", "Invalid scalar cache index");
+    return this.capacity === 1
+      ? 0
+      : Math.imul(index, 0x9e3779b1) >>> (32 - Math.log2(this.capacity));
+  }
+}
