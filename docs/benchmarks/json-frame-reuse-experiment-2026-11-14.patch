diff --git a/packages/core/src/json-frame-reuse.test.ts b/packages/core/src/json-frame-reuse.test.ts
new file mode 100644
index 0000000..7a4b4ea
--- /dev/null
+++ b/packages/core/src/json-frame-reuse.test.ts
@@ -0,0 +1,36 @@
+import { expect, it, vi } from "vitest";
+import { encodeOwnedJsonOutput } from "./json-output-encoding.js";
+import { MemoryBudget } from "./memory-budget.js";
+import { MemoryScope } from "./memory-scope.js";
+
+const counters = vi.hoisted(() => ({ cursors: 0 }));
+vi.mock("./json-container-entries.js", async (importOriginal) => {
+  const original = await importOriginal<typeof import("./json-container-entries.js")>();
+  return {
+    JsonContainerCursor: class extends original.JsonContainerCursor {
+      constructor(value: object) {
+        super(value);
+        counters.cursors++;
+      }
+    },
+  };
+});
+
+it("bounds cursor construction by depth across mixed sibling containers", () => {
+  const value = Array.from({ length: 1000 }, (_, i) =>
+    i % 2 ? { id: i, nested: [undefined, "雪😀", null] } : [i, { flag: true }],
+  );
+  const budget = new MemoryBudget(1024 * 1024);
+  const scope = new MemoryScope(budget);
+  counters.cursors = 0;
+  const output = encodeOwnedJsonOutput(value, scope);
+  try {
+    expect(new TextDecoder().decode(output.value)).toBe(JSON.stringify(value));
+    // Three simultaneously active containers in each of the two passes.
+    expect(counters.cursors).toBe(6);
+  } finally {
+    output.release();
+    scope.dispose();
+  }
+  expect(budget.usedBytes).toBe(0);
+});
