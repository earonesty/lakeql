+
+it("reuses only the immutable right scalar while retaining a bounded live pair", () => {
+  const vector = packed([1, 2, 200]);
+  const scope = new MemoryScope(new MemoryBudget(4096));
+  const reader = new ScalarReadWorkspace(scope);
+  reader.reuseImmutableRight();
+  const decode = vi.spyOn(TextDecoder.prototype, "decode");
+  try {
+    for (let i = 0; i < 1000; i++)
+      expect(reader.consume(vector, i % 2, 2, (a, b) => String(a).length - String(b).length)).toBe(
+        i % 2 ? -198 : -199,
+      );
+    expect(decode).toHaveBeenCalledTimes(1001);
+    expect(scope.budget.peakBytes).toBe(c.object + 4 * c.property + bytes(2) + bytes(200));
+  } finally {
+    decode.mockRestore();
+    reader.dispose();
+    scope.dispose();
+  }
+  expect(scope.budget.usedBytes).toBe(0);
+});
+
+it("drops optional reuse metadata to admit a larger required pair at the original exact cap", () => {
+  const pool = new MemoryBudget(37 + bytes(1) + bytes(400));
+  const sibling = pool.reserve(37, "sibling");
+  const scope = new MemoryScope(pool);
+  const reader = new ScalarReadWorkspace(scope);
+  reader.reuseImmutableRight();
+  const vector = packed([1, 2, 400]);
+  expect(reader.consume(vector, 0, 1, (a, b) => String(a).length - String(b).length)).toBe(-1);
+  expect(reader.consume(vector, 0, 2, (a, b) => String(a).length - String(b).length)).toBe(-399);
+  expect(pool.peakBytes).toBe(pool.maxBytes);
+  reader.dispose();
+  scope.dispose();
+  expect(pool.usedBytes).toBe(37);
+  sibling.release();
+});
+
+it("declines optional reuse inside a fixed admitted stage", () => {
+  const pool = new MemoryBudget(bytes(1) + bytes(200));
+  const parent = new MemoryScope(pool);
+  const stage = parent.childStage(pool.maxBytes, "fixed comparison stage");
+  const reader = new ScalarReadWorkspace(stage);
+  reader.reuseImmutableRight();
+  expect(
+    reader.consume(packed([1, 200]), 0, 1, (a, b) => String(a).length - String(b).length),
+  ).toBe(-199);
+  reader.dispose();
+  stage.dispose();
+  parent.dispose();
+  expect(pool.usedBytes).toBe(0);
+});
+
+it("invalidates reused values across vectors and releases them on consumer failure", () => {
+  const scope = new MemoryScope(new MemoryBudget(4096));
+  const reader = new ScalarReadWorkspace(scope);
+  reader.reuseImmutableRight();
+  expect(reader.consume(packed([1, 2]), 0, 1, (a, b) => String(a).length - String(b).length)).toBe(
+    -1,
+  );
+  const next = packed([1, 200]);
+  expect(reader.consume(next, 0, 1, (a, b) => String(a).length - String(b).length)).toBe(-199);
+  expect(() =>
+    reader.consume(next, 0, 1, () => {
+      throw new Error("consumer failure");
+    }),
+  ).toThrow("consumer failure");
+  expect(scope.budget.usedBytes).toBe(0);
+  reader.dispose();
+  scope.dispose();
+});
+
+it("keeps mutable borrowed reads fresh when reuse is not enabled", () => {
+  const vector: Vector = {
+    type: "utf8-view",
+    data: Uint8Array.of(97, 98),
+    fixedLength: 1,
+    length: 2,
+  };
+  const scope = new MemoryScope(new MemoryBudget(4096));
+  const reader = new ScalarReadWorkspace(scope);
+  expect(reader.consume(vector, 0, 1, (a, b) => String(a).localeCompare(String(b)))).toBe(-1);
+  vector.data[1] = 96;
+  expect(reader.consume(vector, 0, 1, (a, b) => String(a).localeCompare(String(b)))).toBe(1);
+  reader.dispose();
+  scope.dispose();
+  expect(scope.budget.usedBytes).toBe(0);
+});
